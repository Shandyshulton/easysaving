# =====================================================================
# ROOT ENV (TEMPLATE) - dipakai docker-compose untuk Postgres & build args
# Copy menjadi .env. Aktifkan salah satu blok.
# Alur lokal: `docker compose up -d postgres`, backend & frontend manual.
# =====================================================================

# ------- APP_ENV -----------------------------------------------------
APP_ENV=development
# APP_ENV=production

# ------- POSTGRES (kredensial container) -----------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=easysaving

# ------- DATABASE URL (dipakai bila backend jalan via compose) -------
# LOCAL
DATABASE_URL=host=postgres user=postgres password=replace-with-postgres-password dbname=easysaving port=5432 sslmode=disable TimeZone=Asia/Jakarta
# PRODUCTION
# DATABASE_URL=host=postgres user=postgres password=replace-with-strong-postgres-password dbname=easysaving port=5432 sslmode=disable TimeZone=UTC

# ------- JWT ---------------------------------------------------------
JWT_EXPIRES_HOURS=24
# LOCAL
JWT_SECRET=dev-local-secret-change-me
# PRODUCTION
# JWT_SECRET=replace-with-random-letters-and-numbers

# ------- URL & CORS --------------------------------------------------
# LOCAL
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# PRODUCTION
# FRONTEND_ORIGIN=https://easysaving.asia,https://www.easysaving.asia
# NEXT_PUBLIC_SITE_URL=https://easysaving.asia
# NEXT_PUBLIC_API_URL=https://api.easysaving.asia/api/v1

# ------- SMTP (untuk fitur email/OTP) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
