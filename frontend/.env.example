# =====================================================================
# FRONTEND ENV (TEMPLATE)
# Copy menjadi frontend/.env. Aktifkan salah satu blok.
# =====================================================================

# ------- API URL (suffix /api/v1 wajib) ------------------------------
# LOCAL
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# PRODUCTION
# NEXT_PUBLIC_API_URL=https://api.easysaving.asia/api/v1

# ------- SITE URL ----------------------------------------------------
# LOCAL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PRODUCTION
# NEXT_PUBLIC_SITE_URL=https://easysaving.asia

# ------- Akses dari HP / IP LAN (opsional, jalankan: npm run dev:lan) -
# NEXT_PUBLIC_API_URL=http://<IP-LAN>:8080/api/v1
# NEXT_PUBLIC_SITE_URL=http://<IP-LAN>:3000
