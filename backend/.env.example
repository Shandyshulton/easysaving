# =====================================================================
# BACKEND ENV (TEMPLATE)
# Copy menjadi backend/.env, lalu isi nilai asli.
# Aktifkan salah satu blok: baris tanpa "#" = aktif.
# =====================================================================

HTTP_PORT=8080
JWT_EXPIRES_HOURS=24
API_LOG_PATH=logs/api.log

# ------- APP_ENV -----------------------------------------------------
APP_ENV=development
# APP_ENV=production

# ------- DATABASE ----------------------------------------------------
# LOCAL (backend jalan manual, host=localhost)
DATABASE_URL=host=localhost user=postgres password=replace-with-postgres-password dbname=easysaving port=5432 sslmode=disable TimeZone=Asia/Jakarta
# PRODUCTION (Docker Compose, host=nama service "postgres")
# DATABASE_URL=host=postgres user=postgres password=replace-with-strong-postgres-password dbname=easysaving port=5432 sslmode=disable TimeZone=UTC

# ------- JWT SECRET --------------------------------------------------
# LOCAL
JWT_SECRET=dev-local-secret-change-me
# PRODUCTION (acak & panjang, beda dari dev)
# JWT_SECRET=replace-with-random-letters-and-numbers

# ------- CORS / FRONTEND ORIGIN --------------------------------------
# LOCAL
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# PRODUCTION
# FRONTEND_ORIGIN=https://easysaving.asia,https://www.easysaving.asia

# ------- SMTP (untuk fitur email/OTP) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ------- SCAN STRUK (Gemini Vision) ----------------------------------
# Kosongkan GEMINI_API_KEY untuk menonaktifkan fitur scan (form tetap manual).
# API key sisi server saja; JANGAN diberi prefix NEXT_PUBLIC_ dan jangan di-commit.
GEMINI_API_KEY=
# Nama model via env agar mudah diganti tanpa ubah kode.
# Default gemini-2.5-flash (mendukung input gambar + structured output).
# Jika proyek Gemini Anda baru dan tidak punya akses 2.5, ganti ke model
# terbaru yang muncul di Google AI Studio Anda.
GEMINI_MODEL=gemini-2.5-flash
# Rate limit scan (semua opsional; nilai default aman untuk free tier).
RECEIPT_SCAN_PER_MINUTE=5
RECEIPT_SCAN_PER_DAY=30
# Batas global seluruh aplikasi (kuota free tier Gemini berlaku per-proyek).
RECEIPT_SCAN_GLOBAL_PER_MINUTE=8
